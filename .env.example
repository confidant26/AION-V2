APP_NAME=AION V2 API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://aion_user:aion_password@localhost:5432/aion_db

REDIS_URL=redis://localhost:6379/0

PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_DELAY_SECONDS=0.5

COMPANY_PROVIDER_CHAIN=yahoo
MARKET_PROVIDER_CHAIN=yahoo
FINANCIAL_PROVIDER_CHAIN=yahoo