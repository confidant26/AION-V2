APP_NAME=AION V2 API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://aion:aion_password@localhost:5432/aion_db
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_EXEMPT_PATHS=/,/health,/health/database,/health/readiness,/docs,/redoc,/openapi.json

MARKET_PRICE_MAX_AGE_MINUTES=1440
FINANCIAL_PERIOD_MAX_AGE_DAYS=150

PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_DELAY_SECONDS=0.5

COMPANY_PROVIDER_CHAIN=yahoo
MARKET_PROVIDER_CHAIN=yahoo
FINANCIAL_PROVIDER_CHAIN=sec,yahoo

SEC_USER_AGENT=AION-V2 your-email@example.com
